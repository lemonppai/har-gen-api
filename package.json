{
  "name": "har-gen-api",
  "type": "module",
  "version": "0.3.2",
  "license": "MIT",
  "scripts": {
    "start": "node bin/cli.js",
    "build": "esbuild index.ts --format=esm --outfile=dist/index.js && esbuild mockServer.ts --format=esm --outfile=dist/mockServer.mjs && esbuild mockServer.ts --format=cjs --outfile=dist/mockServer.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lemonppai/har-gen-api.git"
  },
  "files": [
    "dist",
    "mockServer.d.ts"
  ],
  "keywords": [
    "har",
    "mock",
    "api",
    "vite"
  ],
  "exports": {
    "./vite": {
      "types": "./mockServer.d.ts",
      "import": "./dist/mockServer.mjs",
      "require": "./dist/mockServer.cjs"
    }
  },
  "bin": {
    "har-gen-api": "bin/cli.js"
  },
  "dependencies": {
    "@types/lodash": "^4.17.25",
    "@types/mockjs": "^1.0.10",
    "@types/node": "^26.2.0",
    "cfonts": "^3.3.1",
    "chalk": "^5.6.2",
    "inquirer": "^14.0.2",
    "json5": "^2.2.3",
    "lodash": "^4.18.1",
    "log-symbols": "^7.0.1",
    "mockjs": "^1.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
