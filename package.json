{
  "name": "har-gen-api",
  "version": "0.4.1",
  "description": "从浏览器 HAR 文件自动生成前端 Mock 接口文件，内置 Vite 插件、Webpack 插件（兼容 Vue CLI 4.0+）与 CLI",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "start": "node bin/cli.js",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "fixtures": "node tests/make-fixtures.mjs",
    "test": "node tests/run.mjs",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lemonppai/har-gen-api.git"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "keywords": [
    "har",
    "mock",
    "api",
    "vite",
    "webpack",
    "vue-cli",
    "mockjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.cjs"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "import": "./dist/webpack.mjs",
      "require": "./dist/webpack.cjs"
    }
  },
  "bin": {
    "har-gen-api": "bin/cli.js"
  },
  "dependencies": {
    "cfonts": "^3.3.1",
    "chalk": "^5.6.2",
    "inquirer": "^14.0.2",
    "json5": "^2.2.3",
    "lodash": "^4.18.1",
    "log-symbols": "^7.0.1",
    "mockjs": "^1.1.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.25",
    "@types/mockjs": "^1.0.10",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.1",
    "typescript": "5.7.3"
  }
}
